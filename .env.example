# Copy to .env and fill in. .env is ignored by Git; never commit real values.

# --- Telegram bot (only needed for `python bot.py`; local JARVIS works without it) ---
# Token from @BotFather, format 1234567890:AAH... (the value below is a placeholder and is rejected).
BOT_TOKEN=123456:replace-with-token-from-botfather
BOT_NAME=ПК-ассистент
# Your numeric Telegram id (ask @userinfobot). Comma-separated for several users.
AUTHORIZED_USER_IDS=
# Optional extra restriction to specific chats. With only chat ids set, access is
# limited to those users' private chats (group members are never authorized).
AUTHORIZED_CHAT_IDS=
ALERTS_ENABLED=true
# Only HTML is supported.
DEFAULT_PARSE_MODE=HTML
RATE_LIMIT_COMMANDS_PER_MINUTE=20
# Seconds a Telegram confirm button stays valid.
CONFIRMATION_TTL_SECONDS=30

# --- Shared by Telegram and JARVIS ---
# Seconds a local (keyboard) confirmation stays valid.
LOCAL_CONFIRMATION_TTL_SECONDS=15
# Shutdown/restart are scheduled with this delay so `shutdown /a` can still cancel them.
SHUTDOWN_DELAY_SECONDS=30
PING_HOST=8.8.8.8
# Relative paths are resolved from the project folder; %VAR% is expanded.
DATA_DIR=./data
LOG_DIR=./logs
# Reserved for a future file-download feature (not used yet).
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_SIZE_MB=100

# --- JARVIS voice ---
# Push-to-talk key: F9, scrolllock, ctrl+space, mouse4 ...
JARVIS_PTT_KEY=F9
# faster-whisper model: tiny | base | small | medium. small is accurate for ru/uk.
JARVIS_STT_MODEL=small
# cpu (works everywhere) | cuda (needs requirements-gpu.txt) | auto
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_LANGUAGES=ru,uk
# Microphone index or name from `python -m jarvis --list-mics`; empty = system default.
JARVIS_INPUT_DEVICE=
JARVIS_MAX_RECORD_SECONDS=15
JARVIS_BEEPS=true
JARVIS_TTS_ENABLED=true
# Hands-free mode (`--listen`): react only to phrases that start with "Джарвис" ...
JARVIS_WAKE_WORD=true
# ... and for this many seconds after a reply keep listening without the wake word.
JARVIS_FOLLOWUP_SECONDS=8
# Speech detection level 0..1 (RMS). 0 = automatic; raise it (e.g. 0.05) in a noisy room.
JARVIS_LISTEN_THRESHOLD=0

# --- Conversation and free-form phrases through local Ollama (loopback only) ---
# If Ollama is not running, JARVIS still handles the basic commands.
JARVIS_OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=30
